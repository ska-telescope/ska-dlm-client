MODE=configdb-watcher
WATCHER_HOSTNAME=dlm_configdb_watcher
LOGLEVEL=DEBUG
SOURCE_NAME=configdb-watcher
SOURCE_PHASE=SOLID
DIRECTORY_TO_WATCH=/dlm/product_dir
TARGET_NAME=dlm-archive
MIGRATION_URL=http://dlm_migration:80
STORAGE_URL=http://dlm_storage:80
INGEST_URL=http://dlm_ingest:80
REQUEST_URL=http://dlm_request:80
QUEUE_CONNECTION_STRING=amqp://guest:guest@rabbitmq/
QUEUE_EXCHANGE_NAME=dlm.outbox
