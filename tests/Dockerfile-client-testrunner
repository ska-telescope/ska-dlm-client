FROM artefact.skao.int/ska-build-python-ubuntu24:1.1.5

RUN apt-get update && apt-get install -y iputils-ping docker.io docker-compose &&\
    mkdir -p /dlm &&\
    useradd -m -G docker ska-dlm &&\
    mkdir -p /home/ska-dlm/.ssh &&\
    chown -R ska-dlm:ska-dlm /home/ska-dlm &&\
    chmod 700 /home/ska-dlm/.ssh

WORKDIR /app

# Install and cache external dependencies
COPY pyproject.toml poetry.lock ./
RUN poetry config virtualenvs.in-project true \
    && poetry env use python3.12 \
    && poetry install --only main,test --no-root

# Install the ska-dlm-client package itself
COPY ./ ./
RUN poetry install --only main,test

ENV PATH="/app/.venv/bin:${PATH}"

ENTRYPOINT ["pytest"]
